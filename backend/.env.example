DATABASE_URL=sqlite:///./data/network.db
# Para PostgreSQL em produção:
# DATABASE_URL=postgresql+psycopg2://infraview:SUA_SENHA@localhost:5432/infraview

SNMP_COMMUNITY=public
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PING_ENABLED=true
PING_TIMEOUT_SEC=1

# Opcional: define faixa específica de sub-rede para ping sweep (ex: 192.168.1.0/24). Se omitido, auto-detecta.
# SCAN_SUBNET=192.168.1.0/24
